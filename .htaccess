# ========================================
# CACHE E PERFORMANCE - PAGESPEED OPTIMIZATION
# ========================================

# Habilitar compressão GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE font/ttf font/otf image/svg+xml
</IfModule>

# ========================================
# CACHE BROWSER - Ciclos de vida eficientes
# ========================================

<IfModule mod_expires.c>
  ExpiresActive On
  
  # HTML - Cache curto (1 dia)
  ExpiresByType text/html "access plus 1 day"
  
  # CSS e JavaScript - Cache longo (30 dias)
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  
  # Imagens - Cache muito longo (60 dias)
  ExpiresByType image/jpeg "access plus 60 days"
  ExpiresByType image/gif "access plus 60 days"
  ExpiresByType image/png "access plus 60 days"
  ExpiresByType image/webp "access plus 60 days"
  ExpiresByType image/svg+xml "access plus 60 days"
  ExpiresByType image/x-icon "access plus 60 days"
  
  # Fontes - Cache muito longo (60 dias)
  ExpiresByType font/ttf "access plus 60 days"
  ExpiresByType font/otf "access plus 60 days"
  ExpiresByType font/woff "access plus 60 days"
  ExpiresByType font/woff2 "access plus 60 days"
  ExpiresByType application/font-woff "access plus 60 days"
  
  # PDF - Cache (30 dias)
  ExpiresByType application/pdf "access plus 30 days"
</IfModule>

# ========================================
# CACHE HEADERS DIRETO
# ========================================

<IfModule mod_headers.c>
  # Imagens
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "max-age=2592000, public"
    Header set Expires "Wed, 01 Jan 2030 00:00:00 GMT"
  </FilesMatch>
  
  # Fontes
  <FilesMatch "\.(woff|woff2|ttf|otf)$">
    Header set Cache-Control "max-age=31536000, public"
    Header set Expires "Wed, 01 Jan 2030 00:00:00 GMT"
  </FilesMatch>
  
  # CSS e JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
    Header set Expires "Wed, 01 Jan 2030 00:00:00 GMT"
  </FilesMatch>
  
  # PDF
  <FilesMatch "\.(pdf)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>

# ========================================
# REWRITE RULES - Remover WWW (opcional)
# ========================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Redirecionar www para não-www
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ http://%1/$1 [R=301,L]
  
  # Força HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ========================================
# SEGURANÇA
# ========================================

# Proteger arquivos sensíveis
<FilesMatch "\.env$|\.git|\.gitignore|\.htaccess|package\.json|\.md$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Bloquear acesso a diretórios
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
